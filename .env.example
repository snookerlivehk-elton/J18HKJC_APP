# J18HKJC_APP — 環境變量範本（阿里雲／Railway 雙邊並行測試）
# 複製為 .env 後填入真實值；勿把含密鑰的 .env 提交進 git。
#
# 兩邊建議：相同變量名、各自控制台填各自值。
#   Railway → Project → Variables
#   阿里雲  → 應用環境變量／容器環境

# ---------- 應用版本（可選；預設讀倉庫根目錄 VERSION）----------
# APP_VERSION=1.1.0

# ---------- 資料庫（必填其一）----------
# SQLite 本機：USE_SQLITE=true
# 雲端 Postgres：USE_SQLITE=false，並設 DATABASE_URL 或 DATABASE_URL_SYNC
USE_SQLITE=false
DATABASE_URL=postgresql://user:password@host:5432/j18db
# 若平台只提供 DATABASE_URL，可省略下一行（meeting_pipeline／tick 會自動後備）
# DATABASE_URL_SYNC=postgresql://user:password@host:5432/j18db

# ---------- JJJC 賽果／排位 API（賽後 tick 必填）----------
JJJC_API_BASE=https://your-api-jjjc.example.com
# 可選別名（與 JJJC_API_BASE 二選一即可）
# JJJC_RESULTS_API_BASE=https://your-api-jjjc.example.com

# ---------- 歷史 J18 API（batch_crawler／ETL）----------
# J18_API_BASE_URL=https://your-j18-api.example.com

# ---------- LLM（Form AI／社交文案；tick 結算不需要）----------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini

# ---------- 賽日 tick（meeting_tick.py）----------
MEETING_TICK_LOOKBACK_DAYS=3
MEETING_TICK_LOOKAHEAD_DAYS=3
MEETING_TICK_COOLDOWN_WAITING_SEC=1800
MEETING_TICK_COOLDOWN_FAILED_SEC=3600
MEETING_TICK_MAX_FAILS=5
# MEETING_TICK_MODE=all
# MEETING_TICK_AUTO_FACTORS=true
# MEETING_TICK_AUTO_FORM_AI=true
# MEETING_TICK_AUTO_SNAPSHOT=true
# Phase D 廣告附屬（預設 true）
# MEETING_TICK_AUTO_SOCIAL_COPY=true
# MEETING_TICK_AUTO_PROMO_HITS=true
# MEETING_TICK_AUTO_POST_RACE_COPY=true
# AD_SOCIAL_TONE=high_interaction
# 數據遺留清單（沿途評述等延遲資料；可超出 lookback）
# MEETING_TICK_AUTO_BACKLOG=true
# MEETING_TICK_BACKLOG_RETENTION_DAYS=14
# MEETING_TICK_BACKLOG_LIMIT=10
# MEETING_TICK_BACKLOG_COVERAGE_OK=0.8
# MEETING_TICK_BACKLOG_AUTO_NLP=true
# 評述入庫後自動 NLP→因子（預設 true；缺評述補齊後應重算干擾）
# MEETING_TICK_BACKLOG_AUTO_FACTORS=true

# ---------- 營運介入報告／管理員通知（Resend；文案後期再優化）----------
# NOTIFY_ENABLED=false
# RESEND_API_KEY=
# NOTIFY_FROM=alerts@j18ai.local
# NOTIFY_ADMIN_EMAILS=admin@example.com,ops@example.com
# 每次 needs_human／stage failed／人工略過會寫 ops_incident_reports；
# notify_admins() 為唯一發信入口（未開 NOTIFY_ENABLED 時 stub）。

# ---------- 廣告輸出（可選）----------
# AD_OUTPUT_DIR=
# AD_OUTPUT_MAX_KB=2048
# AD_FONT_PATH=

# ---------- 廣告包 API（賽前預測 JSON + webhook；start-ad-api.sh）----------
# AD_API_KEY=
# AD_API_PUBLIC_BASE=https://your-ad-api.up.railway.app
# AD_API_CORS=*
# GROK_BOT_WEBHOOK_URL=
# GROK_BOT_WEBHOOK_SECRET=
# GROK_BOT_WEBHOOK_SECRET_HEADER=X-Webhook-Secret
# ready 需海報+AI精選文案（Grok）；false=有海報即可 ready
# AD_PACKAGE_REQUIRE_AI_SOCIAL=true
# AD_POSTER_REQUIRE_KEY=0

# ---------- 預測 API（可選）----------
# PREDICTION_API_KEY=
# PREDICTION_API_CORS=*
# PORT=8000

# ---------- 雙邊 Cron 建議 ----------
# Railway：另開 Cron Service，Start Command:
#   bash start-tick.sh
#   Schedule: */30 * * * *   （或每小時）
# 阿里雲：定時任務／Cron 同樣執行 bash start-tick.sh
# 兩邊請各自指向「該邊」的 DATABASE_URL，以便並行對照結果。
